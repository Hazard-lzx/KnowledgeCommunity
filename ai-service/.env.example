# 阿里云百炼 DashScope API Key（必填）
AI_API_KEY=

# 服务间共享密钥：与单体 application-dev.yml 的 internal.token 一致（必填）
INTERNAL_TOKEN=

# Java 单体地址（内部接口回调）
JAVA_BASE_URL=http://localhost:8080

# Milvus 地址（host:port 或 http://host:port）
MILVUS_URI=http://192.168.80.80:19530

# Redis（与单体同一实例，db 1）
REDIS_URL=redis://:password@192.168.80.80:6379/1

# per-user 每日 AI 调用配额
AI_DAILY_QUOTA=50
